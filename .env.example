APP_NAME="CTRL-Tech"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Local development: SQLite. For Neon/Vercel set DB_CONNECTION=pgsql and DB_URL.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
DB_URL=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=log
MAIL_FROM_ADDRESS="contact@ctrl-tech.local"
MAIL_FROM_NAME="${APP_NAME}"

STOREFRONT_NAME="CTRL-Tech"
STORE_CURRENCY=USD
USD_TO_CDF_RATE=2800
STORE_CONTACT_PHONE=
STORE_CONTACT_EMAIL=
STORE_ADDRESS="Lubumbashi, Haut-Katanga, RDC"
ADMIN_NAME="Administrateur CTRL-Tech"
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SETUP_TOKEN=
