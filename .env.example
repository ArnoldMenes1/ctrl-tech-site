APP_NAME="CTRL-Tech"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Base locale SQLite par défaut : aucun serveur DB requis.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# Pour MySQL local (XAMPP), remplacer les deux lignes DB ci-dessus :
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=ctrl_tech
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
MAIL_FROM_ADDRESS="contact@ctrl-tech.local"
MAIL_FROM_NAME="${APP_NAME}"

STOREFRONT_NAME="CTRL-Tech"
STORE_CURRENCY=USD
USD_TO_CDF_RATE=2800
STORE_CONTACT_PHONE=
STORE_CONTACT_EMAIL=
STORE_ADDRESS="Lubumbashi, Haut-Katanga, RDC"
# Compte administrateur initial (à renseigner dans votre .env local uniquement)
ADMIN_NAME="Administrateur CTRL-Tech"
ADMIN_EMAIL=
ADMIN_PASSWORD=
